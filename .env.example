# Copie ce fichier en .env (jamais commité, voir .gitignore) après avoir
# créé l'External Client App côté Salesforce — voir README.md, section
# "Brancher un vrai sandbox Salesforce" pour la procédure complète.

# --- Flow par défaut : client_credentials (Consumer Key + Secret + Run As User) ---
SF_AUTH_FLOW=client_credentials

# Consumer Key de l'External Client App
SF_CLIENT_ID=

# Consumer Secret de l'External Client App (uniquement nécessaire pour
# client_credentials — jamais commité, jamais log)
SF_CLIENT_SECRET=

# IMPORTANT pour client_credentials : ça doit être le *My Domain* de ton
# org, pas login.salesforce.com/test.salesforce.com. Exemple :
# https://mon-org--nomdusandbox.sandbox.my.salesforce.com
SF_LOGIN_URL=

# --- Uniquement si SF_AUTH_FLOW=jwt (voir README) ---
# Utilisateur "au nom de qui" le JWT s'authentifie
# SF_USERNAME=integration.user@monsandbox.example.com
# Chemin vers la clé privée .pem qui a signé le certificat uploadé sur l'app
# SF_PRIVATE_KEY_PATH=./certs/server.key

# --- Jugement LLM (scoring ICP + rédaction de l'email) ---
# Colle ta clé après le '=' pour activer le vrai jugement. Laissée vide, judge.py
# reste en mode heuristique. OPENAI_API_KEY est utilisé en priorité si les deux
# sont définies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Slack : notification du draft + validation humaine (boutons Approve/Reject) ---
# Bot token de ta Slack App (scope chat:write)
SLACK_BOT_TOKEN=
# Signing secret de la Slack App (onglet "Basic Information") — sert à vérifier
# que les callbacks de /slack/interactions viennent bien de Slack
SLACK_SIGNING_SECRET=
# Canal où poster les notifications de lead (nom ou ID)
SLACK_CHANNEL=#sdr-leads
# --- Webhook d'entrée : secret partagé avec Clay ---
# Clay doit l'envoyer dans l'en-tête X-Webhook-Secret de son action "Send Webhook".
# Sans cette variable, /webhook/lead répond 503 (fail-closed) — voir main.py.
WEBHOOK_SECRET=

# --- Gmail : brouillon créé dans la boîte du SDR après validation Slack ---
# Identifiants de l'OAuth client "Desktop app" (console.cloud.google.com).
# Procédure complète en haut de scripts/gmail_authorize.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Obtenu une seule fois via : env/bin/python scripts/gmail_authorize.py
GMAIL_REFRESH_TOKEN=
# Adresse du SDR autorisée lors de ce flow
GMAIL_SENDER=
